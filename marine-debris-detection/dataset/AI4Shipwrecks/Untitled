def check_pairs():

    print("\n" + "=" * 60)
    print("CHECKING IMAGE / LABEL PAIRS")
    print("=" * 60)

    missing_labels = []

    for split in ["train", "val"]:

        image_dir = (
            YOLO_DATASET /
            "images" /
            split
        )

        label_dir = (
            YOLO_DATASET /
            "labels" /
            split
        )

        images = find_images(image_dir)

        for image in images:

            label = (
                label_dir /
                f"{image.stem}.txt"
            )

            if not label.exists():

                missing_labels.append(
                    image
                )

    if missing_labels:

        print(
            f"\nMissing labels: "
            f"{len(missing_labels)}"
        )

        for image in missing_labels[:20]:
            print(image)

        raise RuntimeError(
            "Some images do not have labels."
        )

    print("Every image has a corresponding label.")


