# ==========================================================
# 17. CHECK LABELS
# ==========================================================

def check_labels():

    print("\n" + "=" * 60)
    print("CHECKING LABELS")
    print("=" * 60)

    label_dirs = [
        YOLO_DATASET / "labels" / "train",
        YOLO_DATASET / "labels" / "val",
    ]

    valid_class_ids = set(
        range(len(ALL_CLASSES))
    )

    total_labels = 0
    invalid_labels = 0
    invalid_classes = 0

    class_counts = {
        class_id: 0
        for class_id in valid_class_ids
    }

    for label_dir in label_dirs:

        for label_file in label_dir.glob("*.txt"):

            total_labels += 1

            try:

                with open(
                    label_file,
                    "r",
                    encoding="utf-8"
                ) as f:

                    lines = f.readlines()

                for line_number, line in enumerate(lines, 1):

                    parts = line.strip().split()

                    if not parts:
                        continue

                    if len(parts) != 5:

                        print(
                            f"Invalid label format: "
                            f"{label_file}"
                        )

                        invalid_labels += 1
                        continue

                    try:

                        class_id = int(parts[0])

                        x = float(parts[1])
                        y = float(parts[2])
                        w = float(parts[3])
                        h = float(parts[4])

                    except ValueError:

                        print(
                            f"Invalid numeric value: "
                            f"{label_file}"
                        )

                        invalid_labels += 1
                        continue

                    # Class ID
                    if class_id not in valid_class_ids:

                        print(
                            f"Invalid class ID {class_id} "
                            f"in {label_file}"
                        )

                        invalid_classes += 1

                    else:

                        class_counts[class_id] += 1

                    # YOLO coordinates
                    values = [
                        x,
                        y,
                        w,
                        h,
                    ]

                    if any(
                        value < 0 or value > 1
                        for value in values
                    ):

                        print(
                            f"Invalid coordinates: "
                            f"{label_file}"
                        )

                        invalid_labels += 1

            except Exception as e:

                print(
                    f"Could not read {label_file}: {e}"
                )

                invalid_labels += 1

    print("\nClass distribution:")

    for class_id, class_name in enumerate(ALL_CLASSES):

        print(
            f"{class_id:2d} "
            f"{class_name:20s} "
            f"{class_counts[class_id]}"
        )

    print("\nLabel files:", total_labels)
    print("Invalid labels:", invalid_labels)
    print("Invalid class IDs:", invalid_classes)

    if invalid_labels > 0 or invalid_classes > 0:

        raise RuntimeError(
            "\nDataset contains invalid labels. "
            "Fix the labels before training."
        )

    print("\nAll labels are valid.")


