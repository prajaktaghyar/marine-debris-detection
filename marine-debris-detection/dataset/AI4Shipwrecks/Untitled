# ==========================================================
# 5. HELPER FUNCTIONS
# ==========================================================

IMAGE_EXTENSIONS = {
    ".jpg",
    ".jpeg",
    ".png",
    ".bmp",
    ".webp",
    ".tif",
    ".tiff",
}


def is_image(path):
    return path.suffix.lower() in IMAGE_EXTENSIONS


def safe_remove_directory(path):
    """
    Delete a directory if it exists.
    Only used for the generated yolo_dataset.
    """

    if path.exists():
        print(f"Removing old generated dataset: {path}")
        shutil.rmtree(path)


def create_directories():
    """
    Create final YOLO directory structure.
    """

    directories = [
        YOLO_DATASET / "images" / "train",
        YOLO_DATASET / "images" / "val",
        YOLO_DATASET / "labels" / "train",
        YOLO_DATASET / "labels" / "val",
    ]

    for directory in directories:
        directory.mkdir(parents=True, exist_ok=True)


# ==========================================================
# 6. FIND MARINE DEBRIS DATASET
# ==========================================================

def find_marine_debris_dataset():

    print("\n" + "=" * 60)
    print("SEARCHING FOR MARINE DEBRIS DATASET")
    print("=" * 60)

    candidates = []

    for path in DATASET_ROOT.rglob("class-image-crops"):

        if not path.is_dir():
            continue

        # Never search inside generated dataset
        if YOLO_DATASET in path.parents:
            continue

        candidates.append(path)

    if not candidates:
        raise FileNotFoundError(
            "\nCould not find 'class-image-crops' inside dataset folder.\n"
            f"Search location:\n{DATASET_ROOT}"
        )

    marine_crops = candidates[0]

    print("Marine debris dataset found:")
    print(marine_crops)

    return marine_crops


# ==========================================================
# 7. FIND AI4SHIPWRECKS DATASET
# ==========================================================

def find_ai4shipwrecks():

    print("\n" + "=" * 60)
    print("SEARCHING FOR AI4SHIPWRECKS DATASET")
    print("=" * 60)

    candidates = []

    for path in DATASET_ROOT.iterdir():

        if not path.is_dir():
            continue

        if path.resolve() == YOLO_DATASET.resolve():
            continue

        name = path.name.lower()

        if (
            "ai4shipwreck" in name
            or "shipwreck" in name
            or "ship-wreck" in name
        ):
            candidates.append(path)

    if candidates:

        print("AI4Shipwrecks dataset found:")
        print(candidates[0])

        return candidates[0]

    # ------------------------------------------------------
    # Second search:
    # Look for YAML containing shipwreck
    # ------------------------------------------------------

    for yaml_file in DATASET_ROOT.rglob("*.yaml"):

        if YOLO_DATASET in yaml_file.parents:
            continue

        try:

            with open(yaml_file, "r", encoding="utf-8") as f:
                data = yaml.safe_load(f)

            if not isinstance(data, dict):
                continue

            names = data.get("names", [])

            if isinstance(names, dict):
                names_text = " ".join(
                    str(v).lower() for v in names.values()
                )
            elif isinstance(names, list):
                names_text = " ".join(
                    str(v).lower() for v in names
                )
            else:
                names_text = ""

            if "shipwreck" in names_text:

                print("AI4Shipwrecks dataset found using YAML:")
                print(yaml_file.parent)

                return yaml_file.parent

        except Exception:
            pass

    # ------------------------------------------------------
    # Nothing found
    # ------------------------------------------------------

    raise FileNotFoundError(
        "\nCould not automatically find AI4Shipwrecks dataset.\n\n"
        "Put the AI4Shipwrecks folder inside:\n"
        f"{DATASET_ROOT}\n\n"
        "Example:\n"
        f"{DATASET_ROOT}\\AI4Shipwrecks"
    )


# ==========================================================
# 8. FIND IMAGES
# ==========================================================

def find_images(folder):

    images = []

    if not folder.exists():
        return images

    for path in folder.rglob("*"):

        if path.is_file() and is_image(path):
            images.append(path)

    return sorted(images)


# ==========================================================
# 9. COPY MARINE DEBRIS CROPS
# ==========================================================

def copy_marine_debris(marine_crops):

    print("\n" + "=" * 60)
    print("PREPARING MARINE DEBRIS DATA")
    print("=" * 60)

    train_images = []
    val_images = []

    # ------------------------------------------------------
    # Each folder represents a class
    # ------------------------------------------------------

    for class_id, class_name in enumerate(MARINE_CLASSES):

        class_folder = marine_crops / class_name

        if not class_folder.exists():

            print(
                f"WARNING: Class folder not found: {class_name}"
            )

            continue

        images = find_images(class_folder)

        if not images:
            print(
                f"WARNING: No images found for {class_name}"
            )
            continue

        random.shuffle(images)

        # 80% train / 20% validation
        split_index = int(len(images) * 0.8)

        train_part = images[:split_index]
        val_part = images[split_index:]

        train_images.extend(
            [(image, class_id, class_name) for image in train_part]
        )

        val_images.extend(
            [(image, class_id, class_name) for image in val_part]
        )

        print(
            f"{class_name:20s} "
            f"total={len(images):4d} "
            f"train={len(train_part):4d} "
            f"val={len(val_part):4d}"
        )

    # ------------------------------------------------------
    # Copy files
    # ------------------------------------------------------

    copy_crop_images(
        train_images,
        "train",
        "debris"
    )

    copy_crop_images(
        val_images,
        "val",
        "debris"
    )

    print("\nMarine debris data prepared.")


# ==========================================================
# 10. COPY CROP IMAGES + FULL IMAGE LABEL
# ==========================================================

def copy_crop_images(items, split, prefix):

    image_destination = (
        YOLO_DATASET / "images" / split
    )

    label_destination = (
        YOLO_DATASET / "labels" / split
    )

    for index, (source, class_id, class_name) in enumerate(items):

        new_name = (
            f"{prefix}_{class_name}_{index:06d}"
            f"{source.suffix.lower()}"
        )

        destination_image = image_destination / new_name

        destination_label = (
            label_destination /
            f"{Path(new_name).stem}.txt"
        )

        shutil.copy2(
            source,
            destination_image
        )

        # Because these are object crops,
        # the object occupies the whole image.
        label = (
            f"{class_id} "
            f"0.5 0.5 1.0 1.0\n"
        )

        with open(
            destination_label,
            "w",
            encoding="utf-8"
        ) as f:

            f.write(label)


# ==========================================================
# 11. DETECT SHIPWRECK YOLO STRUCTURE
# ==========================================================

def find_yolo_split(dataset_path, split):

    """
    Supports:

        images/train
        labels/train

    and:

        train/images
        train/labels

    and:

        valid/images
        valid/labels
    """

    split_names = []

    if split == "train":

        split_names = [
            "train",
        ]

    elif split == "val":

        split_names = [
            "val",
            "valid",
            "validation",
        ]

    for split_name in split_names:

        # ----------------------------------------------
        # Structure:
        # images/train
        # labels/train
        # ----------------------------------------------

        images_dir = dataset_path / "images" / split_name
        labels_dir = dataset_path / "labels" / split_name

        if images_dir.exists():

            return images_dir, labels_dir

        # ----------------------------------------------
        # Structure:
        # train/images
        # train/labels
        # ----------------------------------------------

        images_dir = dataset_path / split_name / "images"
        labels_dir = dataset_path / split_name / "labels"

        if images_dir.exists():

            return images_dir, labels_dir

    return None, None


# ==========================================================
# 12. FIND SHIPWRECK DATASET YAML
# ==========================================================

def find_shipwreck_yaml(dataset_path):

    possible_names = [
        "data.yaml",
        "dataset.yaml",
        "data.yml",
        "dataset.yml",
    ]

    for name in possible_names:

        yaml_file = dataset_path / name

        if yaml_file.exists():
            return yaml_file

    for yaml_file in dataset_path.rglob("*.yaml"):

        if YOLO_DATASET in yaml_file.parents:
            continue

        try:

            with open(
                yaml_file,
                "r",
                encoding="utf-8"
            ) as f:

                data = yaml.safe_load(f)

            if isinstance(data, dict):

                names = data.get("names", [])

                if names:
                    return yaml_file

        except Exception:
            pass

    return None


# ==========================================================
# 13. COPY SHIPWRECK YOLO DATA
# ==========================================================

def copy_shipwreck_yolo(
    dataset_path,
    source_images,
    source_labels,
    split,
):

    destination_images = (
        YOLO_DATASET / "images" / split
    )

    destination_labels = (
        YOLO_DATASET / "labels" / split
    )

    images = find_images(source_images)

    if not images:

        print(
            f"No shipwreck images found in {source_images}"
        )

        return 0

    copied = 0

    for index, image_path in enumerate(images):

        label_path = (
            source_labels /
            f"{image_path.stem}.txt"
        )

        new_name = (
            f"shipwreck_{split}_{index:06d}"
            f"{image_path.suffix.lower()}"
        )

        destination_image = (
            destination_images / new_name
        )

        destination_label = (
            destination_labels /
            f"{Path(new_name).stem}.txt"
        )

        shutil.copy2(
            image_path,
            destination_image
        )

        # --------------------------------------------------
        # If label exists:
        # Convert EVERY source class to shipwreck = 10
        # --------------------------------------------------

        output_lines = []

        if label_path.exists():

            try:

                with open(
                    label_path,
                    "r",
                    encoding="utf-8"
                ) as f:

                    lines = f.readlines()

                for line in lines:

                    parts = line.strip().split()

                    if len(parts) != 5:
                        continue

                    try:

                        x = float(parts[1])
                        y = float(parts[2])
                        w = float(parts[3])
                        h = float(parts[4])

                    except ValueError:
                        continue

                    # Force class ID to shipwreck
                    output_lines.append(
                        f"{SHIPWRECK_CLASS_ID} "
                        f"{x:.6f} "
                        f"{y:.6f} "
                        f"{w:.6f} "
                        f"{h:.6f}\n"
                    )

            except Exception as e:

                print(
                    f"WARNING: Could not read label "
                    f"{label_path}: {e}"
                )

        # --------------------------------------------------
        # If no label exists:
        # Treat whole image as shipwreck crop
        # --------------------------------------------------

        if not output_lines:

            output_lines.append(
                f"{SHIPWRECK_CLASS_ID} "
                f"0.5 0.5 1.0 1.0\n"
            )

        with open(
            destination_label,
            "w",
            encoding="utf-8"
        ) as f:

            f.writelines(output_lines)

        copied += 1

    return copied


# ==========================================================
# 14. PREPARE AI4SHIPWRECKS
# ==========================================================

def prepare_shipwreck_dataset(shipwreck_path):

    print("\n" + "=" * 60)
    print("PREPARING AI4SHIPWRECKS DATA")
    print("=" * 60)

    print("Dataset:")
    print(shipwreck_path)

    train_images, train_labels = find_yolo_split(
        shipwreck_path,
        "train"
    )

    val_images, val_labels = find_yolo_split(
        shipwreck_path,
        "val"
    )

    # ------------------------------------------------------
    # Standard YOLO structure found
    # ------------------------------------------------------

    if train_images is not None:

        print("\nShipwreck TRAIN folder:")
        print(train_images)

        train_count = copy_shipwreck_yolo(
            shipwreck_path,
            train_images,
            train_labels,
            "train"
        )

    else:

        train_count = 0

    if val_images is not None:

        print("\nShipwreck VALIDATION folder:")
        print(val_images)

        val_count = copy_shipwreck_yolo(
            shipwreck_path,
            val_images,
            val_labels,
            "val"
        )

    else:

        val_count = 0

    # ------------------------------------------------------
    # If train/val structure was not found
    # ------------------------------------------------------

    if train_count == 0 and val_count == 0:

        print(
            "\nNo standard YOLO train/validation structure found."
        )

        print(
            "Searching for images..."
        )

        all_images = find_images(shipwreck_path)

        # Remove images that might belong to metadata
        # directories
        all_images = [
            p for p in all_images
            if YOLO_DATASET not in p.parents
        ]

        if not all_images:

            raise FileNotFoundError(
                "\nNo images found inside AI4Shipwrecks."
            )

        random.shuffle(all_images)

        split_index = int(
            len(all_images) * 0.8
        )

        train_list = all_images[:split_index]
        val_list = all_images[split_index:]

        train_items = [
            (image, SHIPWRECK_CLASS_ID, "shipwreck")
            for image in train_list
        ]

        val_items = [
            (image, SHIPWRECK_CLASS_ID, "shipwreck")
            for image in val_list
        ]

        copy_crop_images(
            train_items,
            "train",
            "shipwreck"
        )

        copy_crop_images(
            val_items,
            "val",
            "shipwreck"
        )

        train_count = len(train_list)
        val_count = len(val_list)

    print("\nAI4Shipwrecks prepared.")

    print(
        f"Shipwreck train images: {train_count}"
    )

    print(
        f"Shipwreck validation images: {val_count}"
    )


