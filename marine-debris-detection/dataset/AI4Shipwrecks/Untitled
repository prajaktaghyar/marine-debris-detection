def copy_best_model():

    print("\n" + "=" * 60)
    print("LOCATING BEST MODEL")
    print("=" * 60)

    possible_paths = [

        RUNS_DIR /
        "marine_debris_shipwreck" /
        "weights" /
        "best.pt",

        RUNS_DIR /
        "marine_debris_shipwreck" /
        "best.pt",

    ]

    best_model = None

    for path in possible_paths:

        if path.exists():

            best_model = path
            break

    if best_model is None:

        # Search recursively
        matches = list(
            RUNS_DIR.rglob("best.pt")
        )

        if matches:

            best_model = matches[-1]

    if best_model is None:

        print(
            "\nWARNING: best.pt was not found."
        )

        return None

    destination = RUNS_DIR / "best.pt"

    shutil.copy2(
