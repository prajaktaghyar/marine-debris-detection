def validate_model(model_path):

    print("\n" + "=" * 60)
    print("VALIDATING BEST MODEL")
    print("=" * 60)

    model = YOLO(str(model_path))

    metrics = model.val(

        data=str(DATASET_YAML),

        imgsz=IMAGE_SIZE,

        batch=BATCH_SIZE,

        device=DEVICE,

        workers=WORKERS,

        plots=True,

    )

    print("\nValidation completed.")

    try:

        print(
            f"mAP50: "
            f"{metrics.box.map50:.4f}"
        )

        print(
            f"mAP50-95: "
            f"{metrics.box.map:.4f}"
        )

    except Exception:
        pass

    return metrics


