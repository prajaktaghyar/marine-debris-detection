def train_model():

    print("\n" + "=" * 60)
    print("STARTING YOLO TRAINING")
    print("=" * 60)

    print("\nModel:", BASE_MODEL)
    print("Dataset:", DATASET_YAML)
    print("Classes:", len(ALL_CLASSES))
    print("Epochs:", EPOCHS)
    print("Image size:", IMAGE_SIZE)
    print("Batch size:", BATCH_SIZE)
    print("Workers:", WORKERS)
    print("Device:", DEVICE)

    # ------------------------------------------------------
    # Load model
    # ------------------------------------------------------

    model = YOLO(BASE_MODEL)

    # ------------------------------------------------------
    # Train
    # ------------------------------------------------------

    results = model.train(

        data=str(DATASET_YAML),

        epochs=EPOCHS,

        imgsz=IMAGE_SIZE,

        batch=BATCH_SIZE,

        workers=WORKERS,

        device=DEVICE,

        project=str(RUNS_DIR),

        name="marine_debris_shipwreck",

        exist_ok=True,

        pretrained=True,

        optimizer="auto",

        patience=15,

        save=True,

        plots=True,

        verbose=True,

        seed=SEED,

        cache=False,

    )

    print("\nTraining completed.")

    return results


